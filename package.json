{
  "name": "log-tidy",
  "version": "1.0.0",
  "description": "Production-ready structured log normalization, redaction, sampling, and validation for Node.js pipelines.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "log-tidy": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p .",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:coverage": "npm run build && node --experimental-test-coverage --test test/*.test.mjs",
    "lint": "tsc -p . --noEmit",
    "check": "npm run lint && npm test",
    "start": "node dist/cli.js"
  },
  "keywords": ["logs", "json", "ndjson", "observability"],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiangmaster/agent-ci-dos-lab.git"
  },
  "bugs": {
    "url": "https://github.com/xiangmaster/agent-ci-dos-lab/issues"
  },
  "homepage": "https://github.com/xiangmaster/agent-ci-dos-lab#readme",
  "author": "log-tidy contributors",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.7.0"
  }
}
